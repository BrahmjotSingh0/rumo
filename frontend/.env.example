# Copy to .env (development) and/or .env.production, then adjust as needed.

# Backend API / Socket.IO URL
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional TURN server (only needed for participants behind restrictive
# NATs/firewalls - STUN alone is enough for most networks). Leave unset to
# skip TURN entirely.
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential

# Branding (name, logo, tagline, accent color) is configured via
# public/branding.json, not env vars - edit that file (or replace it after
# building/deploying) to re-brand without a rebuild. See README.md.
