# Copy this file to .env (development) and/or .env.production and fill in real values.
# Never commit .env or .env.production - they're already gitignored.

NODE_ENV=development
PORT=5000

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rumo
DB_USER=rumo
DB_PASSWORD=change-me
DB_SSL=false
DB_MAX_CONNECTIONS=20

# Origin allowed to call this API / connect via Socket.IO (your frontend URL)
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebRTC - STUN is free and public; TURN is optional but recommended for
# participants behind restrictive NATs/firewalls. Leave TURN_SERVERS unset to
# skip it. Format: url|username|credential, comma-separated for multiple servers.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# TURN_SERVERS=turn:your-turn-server:3478|username|credential

LOG_LEVEL=info

# Where uploaded logos are stored (see ADMIN_SETUP_TOKEN below)
UPLOAD_PATH=./uploads

# Required to use the admin panel at /admin (or the /api/settings endpoints
# directly). Without this set, branding can only be changed by editing
# frontend/public/branding.json. Generate one with:
#   openssl rand -hex 20
ADMIN_SETUP_TOKEN=

# Signs the token a client gets when it becomes host, and must present back
# on reconnect. Optional - if unset, a random secret is generated at boot,
# which is fine for a single instance but means hosts have to be re-confirmed
# after every restart. Set this to a fixed value if that matters to you.
#   openssl rand -hex 32
HOST_TOKEN_SECRET=

# Optional webhook, POSTed to for room/participant lifecycle events (see
# docs/API.md). Leave WEBHOOK_URL unset to disable - no requests are made.
# WEBHOOK_SECRET, if set, HMAC-SHA256 signs the body into an
# X-Rumo-Signature header so your endpoint can verify the request came from
# this server.
# WEBHOOK_FORMAT controls the request body shape: "generic" (default) sends
# { event, data, timestamp } for your own receiver; "slack" or "discord"
# sends a plain-text summary shaped for that platform's incoming-webhook
# API, so WEBHOOK_URL can point straight at a Slack/Discord incoming
# webhook URL with no adapter in between.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_FORMAT=generic

# Checks GitHub's public releases API once a day (anonymous - no data about
# this instance is sent) so the admin panel and landing page can show a
# small "update available" notice. Set to false if you'd rather this
# server never make that outbound request at all.
VERSION_CHECK_ENABLED=true
