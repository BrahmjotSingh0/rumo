{
  "name": "rumo-backend",
  "version": "1.0.0",
  "description": "Rumo - self-hosted video conferencing backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:prod": "pm2 delete all || true && pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status",
    "test": "jest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pg": "^8.11.3",
    "pm2": "^7.0.4",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "js-yaml": "^5.4.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "video-conferencing",
    "webrtc",
    "socket.io",
    "self-hosted"
  ],
  "license": "MIT"
}
