# Used by docker-compose.yml. Copy to .env and fill in real values before
# running `docker compose up`, or just run install.sh / install.ps1, which
# does all of this for you. For running backend/frontend without Docker, use
# backend/.env.example and frontend/.env.example instead.

DB_NAME=rumo
DB_USER=rumo
DB_PASSWORD=change-me

# Origin the frontend is served from - must match wherever you access the app
CORS_ORIGIN=http://localhost:5173

# URLs the built frontend will call - change these if the backend isn't on localhost
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional TURN server for participants behind restrictive NATs/firewalls.
# Format: url|username|credential
# TURN_SERVERS=turn:your-turn-server:3478|username|credential

# Required to use the admin panel at /admin to change branding after install
# (name, tagline, logo, accent color) instead of editing files by hand.
# Generate one with: openssl rand -hex 20
ADMIN_SETUP_TOKEN=change-me

# Set a domain here (e.g. meet.example.com) and run
# `docker compose --profile proxy up -d` to have Caddy get you a free,
# auto-renewing HTTPS certificate and reverse-proxy everything through it.
# Leave blank to keep using plain http://localhost.
DOMAIN=

# When DOMAIN is set, install.sh sets this to 127.0.0.1 so the frontend and
# backend are only reachable through Caddy, not directly over plain HTTP.
BIND_ADDR=0.0.0.0
