# Used by docker-compose.yml. Copy to .env and fill in real values before
# running `docker compose up`. For running backend/frontend without Docker,
# use backend/.env.example and frontend/.env.example instead.

DB_NAME=rumo
DB_USER=rumo
DB_PASSWORD=change-me

# Origin the frontend is served from - must match wherever you access the app
CORS_ORIGIN=http://localhost:5173

# URLs the built frontend will call - change these if the backend isn't on localhost
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Optional TURN server for participants behind restrictive NATs/firewalls.
# Format: url|username|credential
# TURN_SERVERS=turn:your-turn-server:3478|username|credential
